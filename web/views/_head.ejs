<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<script src="https://cdn.tailwindcss.com"></script>
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;600;800;900&display=swap" rel="stylesheet">
<style>
body{font-family:'Be Vietnam Pro',sans-serif;background-color:#05060d;background-image:radial-gradient(circle at 15% 10%,rgba(42,27,92,.35),transparent 40%),radial-gradient(circle at 85% 90%,rgba(14,116,144,.3),transparent 40%);color:#e2e8f0;min-height:100vh}
.glass{background:rgba(255,255,255,.05);backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,.1)}
.neon{background:linear-gradient(90deg,#22d3ee,#a78bfa,#fb7185);-webkit-background-clip:text;color:transparent}
.btn{background:linear-gradient(90deg,#8b5cf6,#f43f5e);font-weight:700;border-radius:999px;padding:.65rem 1.4rem;transition:.2s;display:inline-block;text-align:center}
.btn:hover{transform:scale(1.04);box-shadow:0 8px 30px #8b5cf655}
.inp{width:100%;background:rgba(0,0,0,.4);border:1px solid rgba(255,255,255,.12);border-radius:14px;padding:.65rem .9rem;font-size:.9rem;outline:none}
.inp:focus{border-color:#a78bfa;box-shadow:0 0 0 3px #a78bfa33}
.fade{animation:f .7s both}@keyframes f{from{opacity:0;transform:translateY(18px)}}
</style>
