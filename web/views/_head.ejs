<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<script src="https://cdn.tailwindcss.com"></script>
<style>
/* CSS Reset & Standalone Core Styling (Khắc phục hoàn toàn lỗi mất CSS / Trắng xóa) */
*, *::before, *::after { box-sizing: border-box; }
html { font-size: 16px; background-color: #05060d; color: #e2e8f0; }
body {
    margin: 0;
    padding: 0;
    font-family: 'Be Vietnam Pro', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif !important;
    background-color: #05060d !important;
    background-image: radial-gradient(circle at 15% 10%, rgba(42, 27, 92, 0.45), transparent 45%), radial-gradient(circle at 85% 90%, rgba(14, 116, 144, 0.35), transparent 45%) !important;
    color: #e2e8f0 !important;
    min-height: 100vh;
    -webkit-font-smoothing: antialiased;
}

/* Glassmorphism Cards */
.glass {
    background: rgba(15, 23, 42, 0.75) !important;
    background-color: rgba(15, 23, 42, 0.75) !important;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.12) !important;
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
}

/* Neon Text & Gradient Highlights */
.neon {
    background: linear-gradient(90deg, #22d3ee, #a78bfa, #fb7185);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    color: #22d3ee;
    font-weight: 900;
}

/* Button & Interactive */
.btn {
    background: linear-gradient(90deg, #8b5cf6, #f43f5e) !important;
    color: #ffffff !important;
    font-weight: 700;
    border-radius: 9999px;
    padding: 0.65rem 1.4rem;
    transition: transform 0.2s, box-shadow 0.2s;
    display: inline-block;
    text-align: center;
    border: none;
    cursor: pointer;
    text-decoration: none;
}
.btn:hover {
    transform: scale(1.03);
    box-shadow: 0 8px 25px rgba(139, 92, 246, 0.45);
}

/* Inputs */
.inp {
    width: 100%;
    background: rgba(0, 0, 0, 0.55) !important;
    color: #ffffff !important;
    border: 1px solid rgba(255, 255, 255, 0.18) !important;
    border-radius: 12px;
    padding: 0.75rem 1rem;
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
}
.inp:focus {
    border-color: #a78bfa !important;
    box-shadow: 0 0 0 3px rgba(167, 139, 250, 0.25);
}

/* Layout Utilities Fallback */
.flex { display: flex; }
.inline-flex { display: inline-flex; }
.block { display: block; }
.hidden { display: none; }
.items-center { align-items: center; }
.justify-center { justify-content: center; }
.justify-between { justify-content: space-between; }
.text-center { text-align: center; }
.w-full { width: 100%; }
.max-w-sm { max-width: 24rem; }
.p-4 { padding: 1rem; }
.p-6 { padding: 1.5rem; }
.p-8 { padding: 2rem; }
.rounded-3xl { border-radius: 1.5rem; }
.rounded-2xl { border-radius: 1rem; }
.rounded-xl { border-radius: 0.75rem; }
.rounded-full { border-radius: 9999px; }
.font-black { font-weight: 900; }
.font-bold { font-weight: 700; }
.font-semibold { font-weight: 600; }
.text-2xl { font-size: 1.5rem; line-height: 2rem; }
.text-xl { font-size: 1.25rem; line-height: 1.75rem; }
.text-lg { font-size: 1.125rem; line-height: 1.75rem; }
.text-sm { font-size: 0.875rem; line-height: 1.25rem; }
.text-xs { font-size: 0.75rem; line-height: 1rem; }
.mb-1 { margin-bottom: 0.25rem; }
.mb-2 { margin-bottom: 0.5rem; }
.mb-4 { margin-bottom: 1rem; }
.mb-6 { margin-bottom: 1.5rem; }
.mb-8 { margin-bottom: 2rem; }
.mt-1 { margin-top: 0.25rem; }
.mt-5 { margin-top: 1.25rem; }
.mr-1 { margin-right: 0.25rem; }
.mr-2 { margin-right: 0.5rem; }
.gap-4 { gap: 1rem; }
.gap-6 { gap: 1.5rem; }
.space-y-4 > * + * { margin-top: 1rem; }

/* Colors */
.text-slate-100 { color: #f1f5f9; }
.text-slate-300 { color: #cbd5e1; }
.text-slate-400 { color: #94a3b8; }
.text-slate-500 { color: #64748b; }
.text-violet-300 { color: #c4b5fd; }
.text-rose-300 { color: #fda4af; }
.text-rose-400 { color: #fb7185; }
.text-cyan-300 { color: #67e8f9; }
.text-amber-300 { color: #fcd34d; }
.text-emerald-300 { color: #6ee7b7; }
a { color: inherit; text-decoration: none; }
a:hover { opacity: 0.9; }

/* Animation */
.fade { animation: fadeIn 0.6s ease-out both; }
@keyframes fadeIn {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
}
</style>
