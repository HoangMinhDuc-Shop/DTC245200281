<!DOCTYPE html><html lang="vi"><head><title>Soát vé – CineMaster</title><%- include('_head') %>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jsQR/1.4.0/jsQR.min.js"></script>
<style>.scan:after{content:"";position:absolute;left:8%;right:8%;height:2px;background:#22d3ee;box-shadow:0 0 16px #22d3ee;animation:s 2s infinite alternate}
@keyframes s{from{top:10%}to{top:90%}}</style></head>
<body class="flex items-center justify-center p-4">
<div class="glass rounded-3xl p-6 w-full max-w-md fade">
  <h1 class="text-center text-xl font-black neon mb-1"><i class="fa-solid fa-qrcode mr-2"></i>CỔNG SOÁT VÉ</h1>
  <p class="text-center text-xs text-slate-400 mb-4">Quét QR bằng camera hoặc nhập mã thủ công</p>
  <% if (!user || user.role !== 'admin') { %>
    <div class="bg-amber-400/10 border border-amber-400/30 text-amber-300 rounded-xl p-4 text-sm text-center">Cần đăng nhập tài khoản nhân viên (admin). <a href="/login" class="underline">Đăng nhập</a></div>
  <% } else { %>
  <div class="relative scan rounded-2xl overflow-hidden bg-black aspect-square mb-4">
    <video id="v" playsinline muted class="w-full h-full object-cover"></video><canvas id="c" class="hidden"></canvas>
  </div>
  <form id="f" class="flex gap-2 mb-4"><input id="code" class="inp font-mono uppercase" placeholder="CINE-123456"><button class="btn text-sm">Kiểm tra</button></form>
  <div id="res"></div>
  <% } %>
  <a href="/" class="block text-center text-xs text-slate-400 mt-5"><i class="fa-solid fa-arrow-left mr-1"></i>Trang chủ</a>
</div>
<% if (user && user.role === 'admin') { %>
<script>
const $=i=>document.getElementById(i); let busy=false;
async function check(code){
  const r=await fetch('/checkin',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({code})}); const d=await r.json();
  const o=d.order, col=d.ok?'emerald':'rose'; if(navigator.vibrate)navigator.vibrate(d.ok?80:[60,40,60]);
  $('res').innerHTML=`<div class="rounded-2xl p-4 text-sm bg-${col}-500/15 border border-${col}-400/40 text-${col}-300"><b>${d.message}</b>`+
   (o?`<div class="mt-2 text-xs text-slate-300">${o.movie_title}<br>${o.showtime} · Ghế <b class="text-amber-300">${o.seats}</b></div>`:'')+`</div>`;
}
$('f').onsubmit=e=>{e.preventDefault();check($('code').value)};
navigator.mediaDevices?.getUserMedia({video:{facingMode:'environment'}}).then(st=>{const v=$('v');v.srcObject=st;v.play();tick()}).catch(()=>{});
function tick(){const v=$('v');
  if(v.readyState===4&&!busy){const c=$('c'),x=c.getContext('2d');c.width=v.videoWidth;c.height=v.videoHeight;x.drawImage(v,0,0);
    const q=jsQR(x.getImageData(0,0,c.width,c.height).data,c.width,c.height);
    if(q){busy=true;check(q.data).finally(()=>setTimeout(()=>busy=false,2500))}}
  requestAnimationFrame(tick)}
</script>
<% } %>
</body></html>
